---
const navigation = {
  main: [
    { name: 'Services', href: '/services' },
    { name: 'About', href: '/about' },
    { name: 'FAQ', href: '/faqs' },
    { name: 'Gallery', href: '/gallery' },
  ],
  social: [
    {
      name: 'Facebook',
      href: 'https://www.facebook.com/QuantumVitaBodyTherapy',
    },
    {
      name: 'Yelp',
      href: 'https://www.yelp.com/biz/quantum-vita-body-therapy-jersey-city',
    },
  ],
};

const year = new Date().getFullYear();
---

<footer class="bg-primaryBlack">
  <div class="overflow-hidden px-4 py-12 mx-auto max-w-7xl sm:px-6 lg:px-8">
    <div class="mb-8">
      <a href="/">
        <span class="sr-only">Quantum Vita Body Therapy</span>
        <img class="mx-auto w-auto h-20" src="/assets/logo.png" alt="Quantum Vita Logo" />
      </a>
    </div>
    <nav class="flex flex-wrap justify-center -mx-5 -my-2" aria-label="Footer">
      {
        navigation.main.map((item) => (
          <div class="px-5 py-2">
            <a href={item.href} class="text-base text-gray-200 hover:text-gray-400">
              {item.name}
            </a>
          </div>
        ))
      }
    </nav>
    <div class="flex justify-center mt-8 space-x-6">
      {
        navigation.social.map((item) => (
          <a href={item.href} class="text-gray-300 hover:text-gray-500">
            <span class="sr-only">{item.name}</span>
            {item.name === 'Facebook' ? (
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
                  clip-rule="evenodd"
                />
              </svg>
            ) : (
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="m3.57 3.58 7.63 8.22.57-11.04-8.2 2.82zM17.61 6.97l-3.98 6.06 7.02-.94-3.04-5.12zM20.27 17.88l-6.84-2.4 2.6 6.59 4.24-4.19zM11.92 23.24l-.59-7.23-4.96 5.06 5.55 2.17zM3.63 17.79l6.35-3.48-6.63-2.47.28 5.95z"
                  clip-rule="evenodd"
                />
              </svg>
            )}
          </a>
        ))
      }
    </div>
    <div class="flex justify-center mt-8">
      <img class="mx-auto w-auto h-20" src="/assets/amta-logo.png" alt="AMTA Logo" />
    </div>
    <p class="mt-8 text-sm text-center text-gray-400">
      &copy; {year} Quantum Vita LLC. All rights reserved.
    </p>
  </div>
</footer>
